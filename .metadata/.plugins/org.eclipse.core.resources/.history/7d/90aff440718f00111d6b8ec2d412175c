package br.com.javaparaweb.financeiro.web.filter;

import java.io.IOException;
import javax.servlet.*;
import javax.servlet.annotation.WebFilter;
import org.hibernate.*;
import br.com.javaparaweb.financeiro.util.*;

@WebFilter(urlPatterns = { "*.jsf" })
public class ConexaoHibernateFilter implements Filter {

	private SessionFactory sf;

	@Override
	public void init(FilterConfig config) throws ServletException {
		this.sf = HibernateUtil.getSessionFactory();
	}

	@Override
	public void doFilter(ServletRequest servletRequest, ServletResponse servletResponse, FilterChain chain)
			throws IOException, ServletException {

		Session currentSession = this.sf.getCurrentSession();
		Transaction transaction = null;

		try {
			transaction = currentSession.beginTransaction();
			chain.doFilter(servletRequest, servletResponse);
			transaction.commit();
		} catch (Throwable ex) {
			try {
				if (transaction != null && transaction.isActive()) {
					transaction.rollback();
				}
			} catch (Throwable t) {
				t.printStackTrace();
			}
			throw new ServletException(ex);
		} finally {
			// getCurrentSession() geralmente fecha a sessão automaticamente no commit/rollback,
			// mas se ainda estiver aberta, garantimos o fechamento aqui.
			if (currentSession.isOpen()) {
				currentSession.close();
			}
		}
	}


	public void destroy() {
		// Método obrigatório da interface Filter
	}
}

